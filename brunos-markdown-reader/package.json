{
  "name": "brunos-markdown-reader",
  "displayName": "Bruno's Markdown Reader",
  "description": "Opens Markdown files pre-rendered (reading mode), with mermaid diagram support and a beta Notion-like editing experience.",
  "version": "0.0.23",
  "publisher": "brunotrivellato",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bruno-trivellato/apps-vscode-extensions",
    "directory": "brunos-markdown-reader"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "brunosMarkdownReader.editor",
        "displayName": "Bruno's Markdown Reader",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "brunosMarkdownReader.openLink",
        "title": "Open"
      },
      {
        "command": "brunosMarkdownReader.openLinkToSide",
        "title": "Open to the Side"
      },
      {
        "command": "brunosMarkdownReader.copyLinkPath",
        "title": "Copy Link Path"
      },
      {
        "command": "brunosMarkdownReader.escapeToPreview",
        "title": "Back to Preview (Bruno's Markdown Reader)"
      }
    ],
    "keybindings": [
      {
        "command": "brunosMarkdownReader.escapeToPreview",
        "key": "escape",
        "when": "brunosMarkdownReader.canEscapeToPreview && editorTextFocus && editorLangId == markdown && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !parameterHintsVisible && !renameInputVisible && !findWidgetVisible && !referenceSearchVisible && !inSnippetMode"
      }
    ],
    "configuration": {
      "title": "Bruno's Markdown Reader",
      "properties": {
        "brunosMarkdownReader.showGitHeader": {
          "type": "boolean",
          "default": true,
          "description": "Show the git header (last commit + file history) at the top of the rendered view."
        },
        "brunosMarkdownReader.historyExpanded": {
          "type": "boolean",
          "default": false,
          "description": "Start the commit History panel expanded instead of collapsed."
        },
        "brunosMarkdownReader.doubleEscToPreview": {
          "type": "boolean",
          "default": true,
          "description": "When editing a file opened from the reader, press Esc twice to return to preview."
        },
        "brunosMarkdownReader.editMode": {
          "type": "boolean",
          "default": false,
          "description": "BETA: Notion-like experience. Replace the rendered reader with the Vditor instant-render (IR) editor, editing the file in place."
        },
        "brunosMarkdownReader.collapsibleHeadings": {
          "type": "boolean",
          "default": true,
          "description": "Show a fold arrow next to each heading in the reader, to collapse everything under it. Reader only. Folds reset when the file is reopened."
        },
        "brunosMarkdownReader.tableOverflow": {
          "type": "string",
          "enum": [
            "center",
            "left"
          ],
          "default": "center",
          "enumDescriptions": [
            "Grow the table both ways from the centre of the page.",
            "Keep the table's left edge on the text column and grow to the right only."
          ],
          "description": "How a table wider than the text column grows. Applies to both the reader and edit mode."
        }
      }
    },
    "menus": {
      "webview/context": [
        {
          "command": "brunosMarkdownReader.openLink",
          "when": "webviewSection == 'link'",
          "group": "navigation@1"
        },
        {
          "command": "brunosMarkdownReader.openLinkToSide",
          "when": "webviewSection == 'link'",
          "group": "navigation@2"
        },
        {
          "command": "brunosMarkdownReader.copyLinkPath",
          "when": "webviewSection == 'link'",
          "group": "9_cutcopypaste@1"
        }
      ]
    }
  },
  "scripts": {
    "test": "mocha"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "mocha": "^11.1.0",
    "vditor": "^3.11.3"
  }
}
